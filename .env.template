# ==============================================================================
# HIGH SPRINGS PEDIATRICS — VAPI INTEGRATION ENVIRONMENT CONFIGURATION
# Engineered by Pinnacle AI Solutions
#
# Copy to `.env` and fill in real values. NEVER commit `.env`.
# ==============================================================================

# Server
PORT=3000
NODE_ENV=development

# --- Vapi API Credentials -----------------------------------------------------
VAPI_API_KEY=your_vapi_private_api_key_here
VAPI_ASSISTANT_ID=10152953-a211-4737-a005-1705cda37b62

# Shared secret used to verify inbound Vapi webhook signatures
# (src/middleware/webhookAuth.js). Set the same value in the Vapi dashboard.
VAPI_WEBHOOK_SECRET=generate_a_long_random_string

# --- Clinical Portal / Dashboard Basic Auth ---------------------------------
# Protects the dashboard and /api/* routes (src/middleware/authMiddleware.js).
# The server returns 500 until BOTH are set.
DASHBOARD_USER=admin
DASHBOARD_PASS=change_me

# --- Database (Prisma) ------------------------------------------------------
# Default local dev uses SQLite (prisma/schema.prisma).
DATABASE_URL="file:./dev.db"

# --- Clinic Information ----------------------------------------------------
CLINIC_NAME=High Springs Pediatrics
TIMEZONE=America/New_York

# --- Twilio SMS (optional) ----------------------------------------------
# Appointment-confirmation texts. If any of the three is missing, SMS is skipped.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# --- Google Calendar Integration (Service Account or OAuth2) -----------
# 1. Provide your Google Calendar ID (e.g. your_email@gmail.com or primary)
GOOGLE_CALENDAR_ID=primary

# 2. Option A: Path to Google Service Account JSON file
GOOGLE_SERVICE_ACCOUNT_FILE=./service-account.json

# 3. Option B: Direct Service Account credentials
# GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com
# GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
